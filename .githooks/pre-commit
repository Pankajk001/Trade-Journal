#!/bin/sh
if command -v python >/dev/null 2>&1; then
  exec python scripts/check_secrets.py --staged
elif command -v python3 >/dev/null 2>&1; then
  exec python3 scripts/check_secrets.py --staged
else
  echo "Credential check requires Python. Commit stopped to protect local credentials." >&2
  exit 1
fi
